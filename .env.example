# Copy to backend/.env to override defaults. The defaults match docker-compose.yml,
# so a copy is only needed when a setting changes.

DATABASE_URL=postgresql+asyncpg://avi:avi_dev_password@localhost:5432/avi

# Address the API uses when it opens a TCP client to the camera.
COGNEX_HOST=127.0.0.1
COGNEX_PORT=5005
COGNEX_TRIGGER_COMMAND=SE8
COGNEX_COMMAND_TIMEOUT=3.0

# In-process Native Mode simulator. Set to false to talk to a real camera
# (or another process) at COGNEX_HOST:COGNEX_PORT.
COGNEX_MOCK_ENABLED=true
COGNEX_BIND_HOST=0.0.0.0

# Comma-separated browser origins allowed to call the API directly.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
